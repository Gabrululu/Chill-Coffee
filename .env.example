# Public origin for absolute social-preview image URLs (set on your hosting).
# SITE_URL=https://your-cafe.example

# Frontend reads frontend/.env.local; CLI scripts read the ROOT .env.
# Always Stellar Testnet. There is no demo flag or local data fallback.

# Optional server-only override: use ALL THREE values from pnpm registry:deploy.
# Otherwise uses the public deployment in deployments/registry-testnet.json.
# CAFE_REGISTRY_CONTRACT_ID=C...
# CAFE_REGISTRY_WASM_HASH=64-lowercase-hex-digits
# CAFE_REGISTRY_ADMIN=G...

# Optional real AI, server-only. Missing configuration disables generation;
# manual recipe editing and on-chain registration remain available.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# CLI identity name, NEVER a seed or private key. Store identities outside this repo.
STELLAR_IDENTITY=chill-cafe-testnet
# STELLAR_BARISTA_ADDRESS=G...
# STELLAR_CLI=stellar
# STELLAR_CONFIG_DIR=/absolute/path/outside/repository
# Standalone CLI target; shared frontend discovers cafés through CafeRegistry.
# NEXT_PUBLIC_CAFE_CONTRACT_ID=C...
